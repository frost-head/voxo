{
  "name": "voxo",
  "productName": "voxo",
  "author": "frost-head",
  "version": "0.4.5",
  "description": "Reads web pages, pasted text and PDFs aloud with local text-to-speech",
  "main": "main.js",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",

    "package:mac:arm64": "electron-builder --mac dmg --arm64",
    "package:mac:x64": "electron-builder --mac dmg --x64",
    "package:win:x64": "electron-builder --win nsis --x64",
    "package:linux:x64": "electron-builder --linux AppImage --x64",

    "dist:mac:arm64": "pnpm run package:mac:arm64",
    "dist:mac:x64": "pnpm run package:mac:x64",
    "dist:win:x64": "pnpm run package:win:x64",
    "dist:linux:x64": "pnpm run package:linux:x64",

    "dist:all": "pnpm run dist:mac:arm64 && pnpm run dist:mac:x64 && pnpm run dist:win:x64 && pnpm run dist:linux:x64"
  },
  "dependencies": {
    "@echogarden/espeak-ng-emscripten": "^0.3.5",
    "@huggingface/transformers": "^4.3.2",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^31.0.0",
    "kokoro-js": "^1.2.1",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.voxo.reader",
    "productName": "voxo",
    "artifactName": "voxo-${version}-${os}-${arch}.${ext}",
    "files": [
      "**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,tests,__tests__}/**",
      "!.github/**",
      "!test/**",
      "!build/**",
      "!dist/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/",
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "mac": {
      "icon": "assets/icon.svg",
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "CFBundleDisplayName": "voxo",
        "CFBundleName": "voxo"
      }
    },
    "win": {
      "icon": "assets/icon.svg"
    },
    "linux": {
      "icon": "assets/icon.svg"
    }
  }
}
